{{define "queryCodeStd"}}
{{range .GoQueries}}
{{if $.OutputQuery .SourceName}}
{{if and (ne .Cmd ":copyfrom") (ne (hasPrefix .Cmd ":batch") true)}}
const {{.ConstantName}} = {{$.Q}}-- name: {{.MethodName}} {{.Cmd}}
{{escape .SQL}}
{{$.Q}}
{{end}}

{{if ne (hasPrefix .Cmd ":batch") true}}
{{if .Arg.EmitStruct}}
type {{.Arg.Type}} struct { {{- range .Arg.UniqueFields}}
  {{.Name}} {{.Type}} {{if .Tag}}{{$.Q}}{{.Tag}}{{$.Q}}{{end}}
  {{- end}}
}
{{end}}

{{if .Ret.EmitStruct}}
type {{.Ret.Type}} struct { {{- range .Ret.Struct.Fields}}
  {{.Name}} {{.Type}} {{if .Tag}}{{$.Q}}{{.Tag}}{{$.Q}}{{end}}
  {{- end}}
}
{{end}}
{{end}}

{{if eq .Cmd ":one"}}
{{range .Comments}}//{{.}}
{{end -}}
func {{.MethodName}}({{.Arg.Pair}}) {{$.PackageQualifier}}Query[{{.Ret.DefineType}}] {
	{{- template "sliceStatementStd" .}}
	return {{$.PackageQualifier}}NewStatement({{template "statementArgsStd" .}}).One({{if .ScannerName}}{{.ScannerName}}{{else}}{{$.PackageQualifier}}ScanValue[{{.Ret.DefineType}}]{{end}})
}
{{end}}

{{if eq .Cmd ":many"}}
{{range .Comments}}//{{.}}
{{end -}}
func {{.MethodName}}({{.Arg.Pair}}) {{$.PackageQualifier}}Query[[]{{.Ret.DefineType}}] {
	{{- template "sliceStatementStd" .}}
	return {{$.PackageQualifier}}NewStatement({{template "statementArgsStd" .}}).Many({{if .ScannerName}}{{.ScannerName}}{{else}}{{$.PackageQualifier}}ScanValue[{{.Ret.DefineType}}]{{end}})
}
{{end}}

{{if or (eq .Cmd ":exec") (eq .Cmd ":execrows")}}
{{range .Comments}}//{{.}}
{{end -}}
func {{.MethodName}}({{.Arg.Pair}}) {{$.PackageQualifier}}Query[int64] {
	{{- template "sliceStatementStd" .}}
	return {{$.PackageQualifier}}NewStatement({{template "statementArgsStd" .}}).Exec()
}
{{end}}

{{if eq .Cmd ":execresult"}}
{{range .Comments}}//{{.}}
{{end -}}
func {{.MethodName}}({{.Arg.Pair}}) {{$.PackageQualifier}}Query[sql.Result] {
	{{- template "sliceStatementStd" .}}
	return {{$.PackageQualifier}}NewStatement({{template "statementArgsStd" .}}).ExecResult()
}
{{end}}

{{if eq .Cmd ":execlastid"}}
{{range .Comments}}//{{.}}
{{end -}}
func {{.MethodName}}({{.Arg.Pair}}) {{$.PackageQualifier}}Query[int64] {
	{{- template "sliceStatementStd" .}}
	return {{$.PackageQualifier}}NewStatement({{template "statementArgsStd" .}}).ExecLastID()
}
{{end}}

{{end}}
{{end}}

{{range .Scanners}}
{{if $.OutputQuery .SourceName}}
func {{.Name}}(row {{$.PackageQualifier}}Row) ({{.Ret.DefineType}}, error) {
	var {{.Ret.Name}} {{.Ret.Type}}
	err := row.Scan({{.Ret.Scan}})
	return {{.Ret.ReturnName}}, err
}
{{end}}
{{end}}
{{end}}

{{define "statementArgsStd" -}}
{{- if .Arg.HasSqlcSlices}}query, queryParams...
{{- else}}{{.ConstantName}}{{if .Arg.Params}}, {{.Arg.Params}}{{end}}
{{- end}}
{{- end}}

{{define "sliceStatementStd"}}
{{- if .Arg.HasSqlcSlices}}
	query := {{.ConstantName}}
	var queryParams []any
	{{- if .Arg.Struct}}
	{{- $arg := .Arg}}
	{{- range .Arg.Struct.Fields}}
	{{- if .HasSqlcSlice}}
	if len({{$arg.VariableForField .}}) > 0 {
		for _, v := range {{$arg.VariableForField .}} {
			queryParams = append(queryParams, v)
		}
		query = strings.Replace(query, "/*SLICE:{{.Column.Name}}*/?", strings.Repeat(",?", len({{$arg.VariableForField .}}))[1:], 1)
	} else {
		query = strings.Replace(query, "/*SLICE:{{.Column.Name}}*/?", "NULL", 1)
	}
	{{- else}}
	queryParams = append(queryParams, {{$arg.VariableForField .}})
	{{- end}}
	{{- end}}
	{{- else}}
	if len({{.Arg.Name}}) > 0 {
		for _, v := range {{.Arg.Name}} {
			queryParams = append(queryParams, v)
		}
		query = strings.Replace(query, "/*SLICE:{{.Arg.Column.Name}}*/?", strings.Repeat(",?", len({{.Arg.Name}}))[1:], 1)
	} else {
		query = strings.Replace(query, "/*SLICE:{{.Arg.Column.Name}}*/?", "NULL", 1)
	}
	{{- end}}
{{- end}}
{{- end}}
